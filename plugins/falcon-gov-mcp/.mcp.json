{
  "mcpServers": {
    "falcon-gov": {
      "type": "stdio",
      "command": "uvx",
      "args": ["falcon-mcp", "--read-only"],
      "env": {
        "FALCON_CLIENT_ID": "${user_config.falcon_gov_client_id}",
        "FALCON_CLIENT_SECRET": "${user_config.falcon_gov_client_secret}",
        "FALCON_BASE_URL": "https://api.laggar.gcw.crowdstrike.com"
      }
    }
  }
}
