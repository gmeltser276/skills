{
  "mcpServers": {
    "falcon-commercial": {
      "type": "stdio",
      "command": "uvx",
      "args": ["falcon-mcp", "--read-only"],
      "env": {
        "FALCON_CLIENT_ID": "${user_config.falcon_commercial_client_id}",
        "FALCON_CLIENT_SECRET": "${user_config.falcon_commercial_client_secret}",
        "FALCON_BASE_URL": "https://api.us-2.crowdstrike.com"
      }
    },
    "falcon-gov": {
      "type": "stdio",
      "command": "uvx",
      "args": ["falcon-mcp", "--read-only"],
      "env": {
        "FALCON_CLIENT_ID": "${user_config.falcon_gov_client_id}",
        "FALCON_CLIENT_SECRET": "${user_config.falcon_gov_client_secret}",
        "FALCON_BASE_URL": "https://api.laggar.gcw.crowdstrike.com"
      }
    },
    "tenable": {
      "type": "http",
      "url": "https://cloud.tenable.com/mcp/",
      "headers": {
        "X-ApiKeys": "accessKey=${user_config.tenable_access_key};secretKey=${user_config.tenable_secret_key}"
      }
    }
  }
}
