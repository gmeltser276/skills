{
  "mcpServers": {
    "falcon-commercial": {
      "type": "stdio",
      "command": "uvx",
      "args": ["falcon-mcp@0.19.0"],
      "env": {
        "FALCON_CLIENT_ID": "${user_config.falcon_commercial_client_id}",
        "FALCON_CLIENT_SECRET": "${user_config.falcon_commercial_client_secret}",
        "FALCON_BASE_URL": "https://api.us-2.crowdstrike.com",
        "FALCON_MCP_DYNAMIC": "true",
        "FALCON_MCP_USER_AGENT_COMMENT": "ct-soc-cc/0.2.0"
      }
    }
  }
}
